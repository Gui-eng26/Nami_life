# Dashboard MH-009 — variáveis de ambiente do serviço Railway (separado do bot).
# Nunca commitar o .env real.

# Mesmo projeto Supabase do bot (nputymewnwmnhrtpizzs) — a service key vive só aqui,
# nunca no front (BRIEFING_MH009 §12).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# id do usuário Supabase Auth autorizado a acessar o dashboard (usuário admin único).
ADMIN_USER_ID=

# Variáveis do FRONT (Vite embute no bundle em tempo de build — por isso o prefixo
# VITE_). ANON_KEY é a chave pública/publicável do projeto, não a service key: serve só
# para o login (Supabase Auth) rodar no navegador. Mesmo valor de SUPABASE_URL acima.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Porta do serviço Express (API + PWA compilado). Railway injeta a sua própria se omitida.
DASHBOARD_PORT=8080
